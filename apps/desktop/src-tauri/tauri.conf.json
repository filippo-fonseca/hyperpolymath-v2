{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Desktop",
  "version": "0.1.3",
  "identifier": "io.hyperpolymath.jarvis-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JARVIS Desktop",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "JARVIS microphone middleman",
    "longDescription": "Owns the microphone for JARVIS voice commands so the browser does not have to prompt per session.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "providerShortName": null
    },
    "infoPlist": {
      "NSMicrophoneUsageDescription": "JARVIS listens for your voice commands so you do not have to grant Safari microphone access every session.",
      "LSUIElement": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
