{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Desktop",
  "version": "0.0.0",
  "identifier": "io.hyperpolymath.jarvis-desktop",
  "build": {
    "frontendDist": "../web",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JARVIS Desktop",
        "width": 480,
        "height": 360,
        "minWidth": 360,
        "minHeight": 240,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "macOSPrivateApi": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "Utility",
    "shortDescription": "JARVIS microphone middleman",
    "longDescription": "Owns the microphone for JARVIS voice commands so the browser does not have to prompt per session.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "entitlements": null
    },
    "icon": ["icons/tray-icon.png"]
  }
}
