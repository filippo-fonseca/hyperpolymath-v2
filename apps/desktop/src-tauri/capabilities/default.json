{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for JARVIS Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "store:default",
    "global-shortcut:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/*" },
        { "url": "http://127.0.0.1:3000/*" }
      ]
    }
  ]
}
