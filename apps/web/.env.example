# --- Supabase (local dev: `supabase start` populates these) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle runtime) ---
# LOCAL DEV: direct local Postgres is fine
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# PRODUCTION (Supabase Cloud): MUST use the Supavisor transaction pooler.
# Direct connections (db.<ref>.supabase.co:5432) exhaust the role's slot quota
# under serverless workloads. The pooler URL looks like:
#   postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# `prepare: false` is set in lib/db/client.ts to support this pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Google OAuth (passed to Supabase Auth) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Phase 6: /health visual page (Plan 06-04) ---
# Server Component at /(app)/health/page.tsx fetches its own /api/health JSON
# during SSR. Next 16 requires an absolute URL for server-side fetch, so we
# read this var (or fall back to http://localhost:3000 in dev). Production
# deployments MUST set this to the canonical app origin (e.g., https://hyperpolymath.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 4: Google Calendar (Plan 04-01) ---
# OAuth client from Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client ID).
# This is a SEPARATE OAuth client from the Supabase-Auth Google provider above. Type: "Web application".
# Authorized redirect URIs MUST include http://localhost:3000/api/gcal/callback (dev) AND
# https://<prod-domain>/api/gcal/callback (prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Per-environment redirect URI matching the Google Cloud Console authorized redirect.
# Dev = http://localhost:3000/api/gcal/callback; Prod = https://<prod-domain>/api/gcal/callback.
NEXT_PUBLIC_GCAL_REDIRECT_URI=http://localhost:3000/api/gcal/callback
# 32-byte AES-256-GCM key, base64-encoded. Encrypts gcal refresh + access tokens at rest (D-05).
# Generate ONCE per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit. NEVER reuse across prod/dev. Losing it = all stored tokens become unrecoverable
# (users reconnect via /api/gcal/auth).
GCAL_TOKEN_ENC_KEY=

# --- Phase 7: JARVIS Voice (Plans 07-01..04) ---
# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# Groq Whisper large-v3-turbo STT — https://console.groq.com/keys
GROQ_API_KEY=
# ElevenLabs Flash v2.5 TTS — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Picovoice Porcupine wake-word — https://console.picovoice.ai/
# Picovoice's WASM init runs in the BROWSER, so the key must be NEXT_PUBLIC_*.
# The free tier covers 3 users/month — fits single-user MVP. Keep the same
# value mirrored to the server-only var below for any future server-side use.
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
PICOVOICE_ACCESS_KEY=
