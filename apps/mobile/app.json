{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jarvis",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f9f5f0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hyperpolymath.jarvis",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "JARVIS listens when you tap the orb so you can dictate commands.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "JARVIS does not browse your photo library; this access is only referenced by underlying system frameworks and is never used without your explicit action.",
        "NSPhotoLibraryAddUsageDescription": "JARVIS does not save to your photo library; this access is only referenced by underlying system frameworks and is never used without your explicit action."
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/042c3bcf-b3d7-4895-baa2-f0495b2ad6ac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "JARVIS listens when you tap the orb so you can dictate commands."
        }
      ],
      "expo-secure-store",
      "expo-updates",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "JARVIS listens when you tap the orb so you can dictate commands.",
          "speechRecognitionPermission": "JARVIS shows your words live on screen while you dictate."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.hyperpolymath.jarvis.widgets",
          "groupIdentifier": "group.com.hyperpolymath.jarvis",
          "widgets": [
            {
              "name": "TasksWidget",
              "displayName": "Tasks",
              "description": "Scheduled tasks, due dates, and overdue count.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "HabitsWidget",
              "displayName": "Habits",
              "description": "Today's habits and completion progress.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "CaptureWidget",
              "displayName": "Capture",
              "description": "Capture a thought instantly.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/with-widget-version.js",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "042c3bcf-b3d7-4895-baa2-f0495b2ad6ac"
      }
    },
    "owner": "ffyale"
  }
}
