# Copy to .env (NOT .env.example) and fill in.

# USB serial port the Arduino is on.
# macOS Elegoo Uno R3 with CH340 chip typically appears as /dev/cu.usbserial-XXXX
# Find with: pnpm --filter jarvis-physical-bridge list-ports
SERIAL_PORT=/dev/cu.usbserial-2110
SERIAL_BAUD=115200

# Where to POST triggers. Localhost for dev; deployed app URL for prod.
TRIGGER_URL=http://localhost:3000/api/jarvis/physical/trigger

# Shared secret -- MUST match PHYSICAL_TRIGGER_SECRET in apps/web/.env.local
# Generate with: openssl rand -hex 32
PHYSICAL_TRIGGER_SECRET=replace-me-with-openssl-rand-hex-32

# Comma-separated list of command IDs that should fire the wake event.
# Default 1 = the learned wake word. To fire on every recognized command,
# set TRIGGER_IDS=* (asterisk = any).
# To wake JARVIS and start recording on ANY recognized phrase post-wake, use
# TRIGGER_IDS=* and ignore the IDs themselves.
TRIGGER_IDS=1

# Debounce window in milliseconds -- ignore repeat triggers within this window.
# Prevents one utterance from firing the mic multiple times if the module
# emits the wake ID twice in quick succession.
DEBOUNCE_MS=1500
