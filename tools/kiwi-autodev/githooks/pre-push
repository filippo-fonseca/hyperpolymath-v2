#!/usr/bin/env sh
#
# Kiwi auto-dev never-push guard. This is the SOLE push barrier for the worker:
# the headless agent runs with --dangerously-skip-permissions, which bypasses
# Claude command gating, so this git hook is what actually stops a push.
#
# HARD-BLOCK the push if EITHER:
#   - the KIWI_AUTOMATION env var is set and non-empty, OR
#   - any pushed ref is under refs/heads/kiwi/auto/*.
#
# Normal user pushes (KIWI_AUTOMATION unset AND no kiwi/auto/* ref) pass through.
#
# git passes pushed refs on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# POSIX sh only (Husky runs hooks under sh): no bashisms.

# Block if the automation env var is set.
if [ -n "${KIWI_AUTOMATION:-}" ]; then
  echo "pre-push BLOCKED: KIWI_AUTOMATION is set." >&2
  echo "The Kiwi auto-dev worker never pushes. Its branches are review-only; merge them manually." >&2
  exit 1
fi

# Block if any pushed local ref is under refs/heads/kiwi/auto/*.
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip blank lines (for example a deletion with an empty local ref).
  [ -z "${local_ref}" ] && continue
  case "${local_ref}" in
    refs/heads/kiwi/auto/*)
      echo "pre-push BLOCKED: refusing to push ${local_ref}." >&2
      echo "kiwi/auto/* branches are review-only. Inspect, then merge locally: git checkout main && git merge <branch>." >&2
      exit 1
      ;;
  esac
done

# No automation, no kiwi/auto/* ref: allow the push.
exit 0
