{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-triage.sh\"",
            "timeout": 15,
            "statusMessage": "Loading open issues for triage"
          }
        ]
      }
    ]
  }
}
