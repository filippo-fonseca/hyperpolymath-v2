{
  "name": "hyperpolymath-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "cache-gate": "node apps/web/scripts/cache-invalidator-gate.mjs --all",
    "lint": "pnpm --filter web lint",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "verify:bootstrap": "pnpm --filter web exec node scripts/verify/bootstrap.mjs",
    "verify:seed": "pnpm --filter web exec node scripts/verify/seed.mjs",
    "verify:auth": "pnpm --filter web exec node scripts/verify/storage-state.mjs",
    "verify:drift": "pnpm --filter web exec node scripts/schema-drift-report.mjs",
    "verify:e2e": "playwright test",
    "verify": "pnpm verify:bootstrap && pnpm verify:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "husky": "^9.0.0"
  }
}
