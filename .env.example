# Hyperpolymath environment template.
# Copy to apps/web/.env.local and fill in real values. .env.local is gitignored.
# For production, set these in your host's dashboard (Vercel, Fly, etc.), not here.

# ── Supabase ──────────────────────────────────────────────────────────
# Local dev: `pnpm dlx supabase start` from apps/web/, then `supabase status`
# gives you the values below. For cloud, copy from your project's API page.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only. never imported into client code.

# Drizzle connects directly to Postgres.
# Local:   postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud:   the Supavisor pooler URL (port 6543). Direct connections exhaust slots.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Auth: Google OAuth via Supabase ───────────────────────────────────
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
# Add http://127.0.0.1:54321/auth/v1/callback to its authorized redirect URIs.
# For local dev, these are read by `supabase start` and passed to GoTrue.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Google Calendar ───────────────────────────────────────────────────
# A separate OAuth client from the one above. Web application type.
# Authorized redirect URIs must include:
#   http://localhost:3000/api/gcal/callback   (dev)
#   https://<your-domain>/api/gcal/callback   (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GCAL_REDIRECT_URI=http://localhost:3000/api/gcal/callback

# 32-byte AES-256-GCM key, base64-encoded. Encrypts gcal refresh + access tokens.
# Generate once per environment, never reuse across prod/dev, never commit.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means every user has to reconnect their calendar.
GCAL_TOKEN_ENC_KEY=

# ── JARVIS agent (Anthropic) ──────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Voice (optional; only needed for Phase 7 voice mode) ──────────────
# Groq Whisper large-v3-turbo, STT.
GROQ_API_KEY=
# ElevenLabs Flash v2.5, TTS.
ELEVENLABS_API_KEY=
# Picovoice Porcupine wake-word. Initialises in the browser, so the public copy
# is required. Free tier covers 3 users/month.
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
PICOVOICE_ACCESS_KEY=

# ── App ───────────────────────────────────────────────────────────────
# Absolute origin for server-side fetches. In prod, set to your canonical URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Physical extender (optional) ──────────────────────────────────────
# Shared secret between the desktop app and the macropad bridge process.
# Generate any random 32+ byte hex string. Only needed if you're running
# tools/jarvis-physical.
PHYSICAL_TRIGGER_SECRET=
