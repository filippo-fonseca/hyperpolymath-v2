# Supabase (cloud)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase (server only — NEVER imported into client code)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Drizzle / postgres-js — MUST be Supavisor transaction-mode pooler (port 6543)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Local Supabase (for D-13 local dev with `supabase start`)
# Default local URL — overrides DATABASE_URL when running locally
DATABASE_URL_DEV=postgresql://postgres:postgres@127.0.0.1:54322/postgres
