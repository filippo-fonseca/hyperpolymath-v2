# Hyperpolymath v2 environment template
# Copy to apps/web/.env.local (NOT repo root) and fill in real values.
# .env.local is gitignored — never commit it.

# ─────────────────────────────────────────────────────────────────────
# LOCAL DEV (the default for `pnpm dev` + `pnpm test`)
# Run `pnpm dlx supabase start` from apps/web/ then `supabase status`
# to get the actual local values to paste below.
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<from supabase status>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<from supabase status — server only, never imported into client code>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase reads these at `supabase start` time and feeds them to GoTrue
# for the [auth.external.google] block in apps/web/supabase/config.toml.
# Get values from: https://console.cloud.google.com/apis/credentials → "Hyperpolymath Web" OAuth client.
# Add http://127.0.0.1:54321/auth/v1/callback to its Authorized redirect URIs.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google client id ending in .apps.googleusercontent.com>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google client secret starting with GOCSPX->

# ─────────────────────────────────────────────────────────────────────
# PRODUCTION (set in Vercel dashboard, NOT this file)
# When deploying, the Vercel project's env vars take precedence.
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon JWT or sb_publishable_*>
#   SUPABASE_SERVICE_ROLE_KEY=<service-role JWT or sb_secret_*>
#   DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (Supavisor TRANSACTION mode, port 6543 — prepare:false is enforced in code)
# Cloud Supabase Google OAuth is configured in the Supabase Dashboard
# (Auth → Providers → Google), not via env vars.
# ─────────────────────────────────────────────────────────────────────

# --- Phase 7: JARVIS Voice (Plans 07-01..04) ---
# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# Groq Whisper large-v3-turbo STT — https://console.groq.com/keys
GROQ_API_KEY=
# ElevenLabs Flash v2.5 TTS — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Picovoice Porcupine wake-word — https://console.picovoice.ai/
# Picovoice's WASM init runs in the BROWSER, so the key must be NEXT_PUBLIC_*.
# The free tier covers 3 users/month — fits single-user MVP. Keep the same
# value mirrored to the server-only var below for any future server-side use.
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
PICOVOICE_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────
# PHASE 8 — PUBLIC LANDING (LAND-GH-ENV / D-09)
# The landing manifesto's BuildLog Server Component fetches the last N
# commits from the GitHub REST API via ISR (revalidate: 600).
# ─────────────────────────────────────────────────────────────────────

# GITHUB_TOKEN — classic Personal Access Token, public-repo read scope ONLY.
# Generate at: https://github.com/settings/tokens (Classic) → scope "public_repo"
#
# Why it's needed:
#   - Unauthenticated: 60 req/hr/IP rate limit (GitHub primary).
#   - Authenticated: 5,000 req/hr per token. Removes the "secondary rate limit
#     after a multi-region deploy" failure mode (see 08-RESEARCH.md Pitfall 4).
#   - ISR collapses traffic to ~6 calls/hr/region globally, so unauthenticated
#     technically suffices for low-traffic — but the token costs nothing and
#     hardens against deploy-burst rate limits.
#
# Failure mode if absent:
#   - BuildLog returns the degraded variant ("→ Commit feed unavailable. See the repo
#     directly.") instead of the commit list. Block 1 (currently shipping, parsed
#     from ROADMAP.md) still renders. This is D-10 graceful degradation by design.
GITHUB_TOKEN=
